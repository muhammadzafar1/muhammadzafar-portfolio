# ===== Server =====
# Port the API listens on
PORT=5000
# development | production
NODE_ENV=development
# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: http://localhost:5173 or https://your-app.up.railway.app
CORS_ORIGIN=http://localhost:5173

# ===== MongoDB =====
# MongoDB connection string
# Replace <username>, <password>, and <cluster-url> with your Atlas details.
# Use database name `portfolio` and collection name `data`.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/portfolio?retryWrites=true&w=majority

# ===== Auth =====
# Long random string used to sign JWT tokens (e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-string

# Default admin account (created automatically on first boot)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# ===== Email notifications (Resend HTTP API) =====
# Create an API key at https://resend.com
RESEND_API_KEY=re_XXXXXXXX
# Verified sender email identity, e.g. "Portfolio <noreply@yourdomain.com>"
MAIL_FROM=Portfolio <noreply@yourdomain.com>
# Inbox that receives contact-form notifications
MAIL_TO=you@example.com

